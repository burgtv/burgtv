{
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/:path(.*)",
      "has": [{ "type": "host", "value": "www.burgtv.com" }],
      "destination": "https://burgtv.com/:path",
      "statusCode": 301
    },
    {
      "source": "/legal/:doc(terms|privacy|cookies|aup|dmca|good-faith|transparency|delete-account|faq).html",
      "destination": "/legal/:doc/",
      "statusCode": 301
    }
  ]
}
