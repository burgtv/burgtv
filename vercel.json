{
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/tv",
      "destination": "https://app.burgtv.com/collega",
      "statusCode": 302
    },
    {
      "source": "/tv/",
      "destination": "https://app.burgtv.com/collega",
      "statusCode": 302
    },
    {
      "source": "/:path(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.burgtv.com"
        }
      ],
      "destination": "https://burgtv.com/:path",
      "statusCode": 301
    },
    {
      "source": "/legal/:doc(terms|privacy|cookies|aup|dmca|good-faith|transparency|delete-account|faq).html",
      "destination": "/legal/:doc/",
      "statusCode": 301
    },
    {
      "source": "/pt/como-abrir-ficheiro-m3u",
      "destination": "/pt/como-abrir-arquivo-m3u/",
      "statusCode": 301
    },
    {
      "source": "/pt/como-abrir-ficheiro-m3u/",
      "destination": "/pt/como-abrir-arquivo-m3u/",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(vetrina|fonts|icons|og)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
